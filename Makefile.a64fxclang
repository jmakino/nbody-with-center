#PS_PATH =../fdps/fdps-test/src/
PS_PATH =../fdps/fdps-devel/src/
PS_PATH_PIKG = ../PIKG/
#PS_PATH_PIKG = ../fdps/fdps-devel/pikg/
#PS_PATH_PIKG = ../GPLUM/GPLUM/PIKG/

INC = -I$(PS_PATH)

#CC = time g++
CC = time FCCpx  -Nclang --std=c++17  
#CFLAGS = -O3 --std=c++11 -g
#CFLAGS += -Wall
#CFLAGS += -ffast-math
#CFLAGS += -funroll-loops
#CFLAGS += -DPARTICLE_SIMULATOR_THREAD_PARALLEL -fopenmp
#CFLAGS += -DPARTICLE_SIMULATOR_MPI_PARALLEL

CFLAGS = -Ofast -mcpu=a64fx+sve  #-msve-vector-bits=512 
#CFLAGS += -ffj-swp  -ffj-lst-out=compile.lst -ffj-src
CFLAGS += -ffj-loop-fission 
#CFLAGS += -Rpass=sve-loop-vectrizable
CFLAGS += -Rpass=.*
CFLAGS += -DPARTICLE_SIMULATOR_THREAD_PARALLEL -fopenmp
CFLAGS += -DPARTICLE_SIMULATOR_USE_SAMPLE_SORT

MPICC =  time mpiFCCpx -Nclang --std=c++17

MPICFLAGS = $(CFLAGS) -DPARTICLE_SIMULATOR_MPI_PARALLEL
SRCS = LICENSE  Readme.md nbody-with-center.cpp user-defined.hpp\
      Makefile ringin	 ring.rb	  samplein ringin_hot \
      Makefile.a64fx Makefile.a64fxclang \
      moontest20k.in
      
EXPORTDIR = ../nbody-with-center-export
use_phantom_grape_x86 = no
#use_gpu_cuda = yes

CFLAGS_USE_PIKG =  -DUSE_PIKG_KERNEL  -DPIKG_USE_FDPS_VECTOR -I $(PS_PATH_PIKG)inc

#CFLAGS += $(CFLAGS_USE_PIKG)
CFLAGS_PIKG = $(CFLAGS)    -DUSE_POLAR_COORDINATE

#PIKG_CONVERSION_TYPE = AVX-512
#PIKG_CONVERSION_TYPE = AVX2
PIKG_CONVERSION_TYPE = A64FX
#PIKG_CONVERSION_TYPE = reference
PIKG_SRCS = epsp.hpp epep.hpp

CFLAGS_KERNEL_EPSP =   --kernel-name epsp_pikg \
                      --epi-name Epi --epj-name Epj \
                    --force-name Force \
		    --strip-mining 256 \
		    --unroll 8 \
                    
CFLAGS_KERNEL_EPSP2 = $(CFLAGS_KERNEL_EPSP) \
                     --conversion-type $(PIKG_CONVERSION_TYPE)
CFLAGS_KERNEL_EPEP =   --kernel-name epep_pikg \
                      --epi-name PPEpi --epj-name PPEpj \
                    --force-name PPForce \
		    --strip-mining 256
#     		    --unroll 8 \

CFLAGS_KERNEL_EPEP2 = $(CFLAGS_KERNEL_EPEP) \
                     --conversion-type $(PIKG_CONVERSION_TYPE)
                    


# fdps-autotest-set-vars (DO NOT CHANGE THIS LINE)

all:nbody-with-center


ifeq ($(use_phantom_grape_x86),yes)
PG_ROOT = $(PS_PATH)/phantom_grape_x86/G5/newton/libpg5
INC += -I$(PG_ROOT)
CFLAGS  += -DENABLE_PHANTOM_GRAPE_X86
CLIBS   = -L$(PG_ROOT) -lpg5
PG_BUILD = cd $(PG_ROOT) && $(MAKE) distclean libpg5.a
PG_CLEAN = cd $(PG_ROOT) && $(MAKE) distclean
else
PG_BUILD =
PG_CLEAN = 
endif

ifeq ($(use_gpu_cuda),yes)
CUDA_HOME = /usr/local/cuda
#CUDA_HOME = /gwfefs/opt/x86_64/cuda/7.5
NVCC = time $(CUDA_HOME)/bin/nvcc -Xcompiler="-O3"
INC  += -I$(CUDA_HOME)/samples/common/inc/
CFLAGS  += -DENABLE_GPU_CUDA
CLIBS = -L$(CUDA_HOME)/lib64 -lcudart -lgomp
force_gpu_cuda.o:force_gpu_cuda.cu
	$(NVCC) $(INC) -c -o $@ $<
OBJS = force_gpu_cuda.o
endif

nbody-with-center:nbody-with-center.cpp user-defined.hpp  $(OBJS)
	$(CC)   $(INC) $(CFLAGS) -o $@ nbody-with-center.cpp $(CLIBS)
nbody-with-center-mpi:nbody-with-center.cpp user-defined.hpp  $(OBJS)
	$(MPICC) $(INC) $(MPICFLAGS) -o $@ nbody-with-center.cpp $(CLIBS)
nbody-with-center-quad-mpi:nbody-with-center.cpp user-defined.hpp  $(OBJS)
	$(MPICC) $(INC) $(MPICFLAGS) -DQUAD -o $@ nbody-with-center.cpp $(CLIBS)
nbody-with-center-quad:nbody-with-center.cpp user-defined.hpp  $(OBJS)
	$(CC)  $(INC) $(CFLAGS) -DQUAD -o $@ nbody-with-center.cpp $(CLIBS)
nbody-with-center-quad-mpi-pikg:nbody-with-center.cpp user-defined.hpp  $(OBJS) $(PIKG_SRCS) 
	$(MPICC) $(INC) $(MPICFLAGS)  $(CFLAGS_USE_PIKG) -DQUAD -o $@ nbody-with-center.cpp $(CLIBS)
nbody-with-center-quad-pikg:nbody-with-center.cpp user-defined.hpp  $(OBJS) $(PIKG_SRCS) 
	$(CC)  $(INC) $(CFLAGS)  $(CFLAGS_USE_PIKG) -DQUAD -o $@ nbody-with-center.cpp $(CLIBS)


epsp.hpp: epsp.pikg
	$(PS_PATH_PIKG)bin/pikg -i epsp.pikg -o epsp.hpp $(CFLAGS_KERNEL_EPSP2)
	ruby pikg-fix-swp.rb < epsp.hpp > tmp.hpp
	mv tmp.hpp epsp.hpp
epep.hpp: epep.pikg
	$(PS_PATH_PIKG)bin/pikg -i epep.pikg -o epep.hpp $(CFLAGS_KERNEL_EPEP2)
	ruby pikg-fix-swp.rb < epep.hpp > tmp.hpp
	mv tmp.hpp epep.hpp

clean:
	rm -f *.o *~ nbody-with-center

distclean: clean
	$(PG_CLEAN)
	rm -f nbody-with-center
	rm -rf result


test: 
	# This command is only for FDPS developers.
	./test.py

export:
	rsync -avu $(SRCS) $(EXPORTDIR)
export-git:
	make export
	cd $(EXPORTDIR); git commit -a ; git push
# fdps-autotest-run (DO NOT CHANGE THIS LINE)
